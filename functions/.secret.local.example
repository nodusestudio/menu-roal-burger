# Copia este archivo a functions/.secret.local (que está en .gitignore, nunca se sube a git)
# y completa tus valores reales para probar las Cloud Functions con el emulador local
# (`firebase emulators:start`). En producción, estos mismos nombres se configuran con
# `firebase functions:secrets:set NOMBRE`.

# Requerido para que el agente de IA (agentChatWeb / ultramsgWebhook) responda:
ANTHROPIC_API_KEY=

# Solo necesarios si vas a probar el envío/recepción real de WhatsApp (OTP o el webhook del agente):
ULTRAMSG_INSTANCE=
ULTRAMSG_TOKEN=
ULTRAMSG_WEBHOOK_TOKEN=

# Solo necesario si vas a probar el login de admin (verifyRecaptcha):
RECAPTCHA_SECRET=
