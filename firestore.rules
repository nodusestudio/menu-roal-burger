rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /configuracion/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categorias/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /productos/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /botones/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /bebidas/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /acompanantes/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /promociones/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /combos_especiales/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /promos_2x1/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /combospacks/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pedidos/{doc} {
      allow read: if true;
      // El checkout web publico (source:'web') ya no escribe pedidos directo: pasa por la
      // Cloud Function submitPublicOrder, que recalcula el total contra el catalogo real
      // (functions/pricing.js) antes de crear el documento con el Admin SDK -- y el Admin SDK
      // ignora esta regla de todas formas. Esta condicion solo bloquea un intento de escribir
      // /pedidos directo desde el navegador haciendose pasar por ese canal (con un total
      // inventado). El POS del local / meseros (source:'admin_pos') y cualquier otro origen
      // siguen escribiendo igual que siempre, sin ningun cambio de comportamiento.
      allow create: if true
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.source != 'web';
      allow update: if isAdmin()
        || (resource.data.meseroId is string && resource.data.meseroId.size() > 0
            && resource.data.paymentMethod == 'pendiente'
            && request.resource.data.meseroId == resource.data.meseroId);
      allow delete: if isAdmin()
        || (resource.data.meseroId is string && resource.data.meseroId.size() > 0
            && resource.data.paymentMethod == 'pendiente');
    }

    match /pedidos_archivados/{doc} {
      allow read, write: if isAdmin();
    }

    match /pedidos/_meta_order_sequence {
      allow read: if true;
      allow write: if request.resource.data.metaType == 'order_sequence'
        && request.resource.data.current is int;
    }

    // Antes cualquiera podia crear cualquier mensaje (allow create: if true), incluido
    // 'password_reset_request' haciendose pasar por el telefono/nombre de otro cliente -- ese
    // mensaje es justo lo que hace creible una solicitud falsa de "resetear mi cuenta" ante el
    // admin. 'password_reset_request' ahora solo lo crea submitPasswordResetRequest (Admin SDK,
    // exige OTP verificado) — el navegador ya no puede crear ese tipo directo. Los otros dos
    // tipos que SI siguen escribiendose desde el navegador (mensaje directo del perfil, solicitud
    // de borrar cuenta) ya solo se llaman con una sesion real activa, asi que se exige que
    // request.auth.uid coincida con el clientId del telefono que el mensaje dice ser -- nadie
    // puede mandar un mensaje a nombre de un telefono que no es el suyo.
    match /mensajes/{doc} {
      allow create: if isAdmin()
        || (
          request.auth != null
          && request.resource.data.type in ['customer_direct_message', 'account_delete_request']
          && request.resource.data.customerPhoneDigits is string
          && request.auth.uid == 'phone_' + request.resource.data.customerPhoneDigits
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 4000
        );
      // El cliente logueado lee sus propios mensajes (script-v2.js:774, query .where
      // customerPhoneDigits == su numero -- el mismo campo que se chequea acá, asi que Firestore
      // puede validar la query completa contra la regla). Antes read: if isAdmin() bloqueaba esto
      // en silencio (el onSnapshot del cliente tiene un error handler vacio) -- el panel "mis
      // mensajes" nunca mostraba nada.
      allow read: if isAdmin()
        || (
          request.auth != null
          && resource.data.customerPhoneDigits is string
          && request.auth.uid == 'phone_' + resource.data.customerPhoneDigits
        );
      allow update, delete: if isAdmin();
    }

    // Credenciales de cliente (passwordHash + passwordSalt) -- viven separadas de /clientes
    // para que ninguna regla de esa coleccion pueda terminar exponiendolas por accidente.
    // Solo las Cloud Functions (Admin SDK, se saltan estas reglas) las leen/escriben.
    match /clientes_credenciales/{clientId} {
      allow read, write: if false;
    }

    match /clientes/{clientId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == clientId;
      }
      // Si ya existe un credencial (cuenta reclamada con PIN) para este telefono, un pedido de
      // invitado con ese mismo numero SOLO puede sumar estadisticas de pedido -- nunca pisar el
      // nombre/direccion/telefono que el dueno real ya configuro. Probado a mano: sin este
      // chequeo, cualquiera podia sobrescribir el nombre de una cuenta ajena ya registrada
      // "haciendo un pedido de invitado" con su numero, sin conocer su PIN.
      function hasCredentials() {
        return exists(/databases/$(database)/documents/clientes_credenciales/$(clientId));
      }

      // Invitado SIN cuenta reclamada todavia: el checkout (upsertClientProfile) puede crear y
      // acumular nombre/direccion/estadisticas normalmente -- ya no incluye googleUid/googleEmail
      // (el auto-vinculo de Google pendiente ahora escribe con el Admin SDK via
      // linkPendingGoogleAfterOrder, no directo desde el navegador) ni credenciales (ya ni
      // siquiera viven en este documento).
      allow create: if !hasCredentials()
        && request.resource.data.keys().hasOnly([
          'customerName', 'customerPhone', 'customerPhoneDigits', 'address', 'savedAddresses',
          'lastOrderCode', 'lastOrderId', 'lastOrderTotal', 'totalOrders', 'totalSpent',
          'source', 'firstOrderAt', 'createdAt', 'updatedAt', 'lastOrderAt'
        ])
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() > 0;

      // puntosDisponibles/puntosAcumuladosTotal (acumulación de puntos de lealtad, ver
      // functions/index.js: awardLoyaltyPoints) son de escritura EXCLUSIVA de Cloud Functions
      // (Admin SDK, que de todas formas ignora estas reglas) -- ninguna rama de abajo, ni
      // siquiera isAdmin()/isOwner(), puede tocarlos desde el navegador. Es la única forma de
      // que la transacción del trigger siga siendo la fuente de verdad única de los puntos.
      function touchesLoyaltyPoints() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['puntosDisponibles', 'puntosAcumuladosTotal']);
      }

      allow update: if !touchesLoyaltyPoints()
        && (
          isAdmin()
          || isOwner()
          || (
            !hasCredentials()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'customerName', 'customerPhone', 'customerPhoneDigits', 'address', 'savedAddresses',
              'lastOrderCode', 'lastOrderId', 'lastOrderTotal', 'totalOrders', 'totalSpent',
              'source', 'updatedAt', 'lastOrderAt'
            ])
          )
          || (
            hasCredentials()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastOrderCode', 'lastOrderId', 'lastOrderTotal', 'totalOrders', 'totalSpent',
              'updatedAt', 'lastOrderAt'
            ])
          )
        );

      allow delete: if isAdmin() || isOwner();
      allow read: if isAdmin() || isOwner();
    }

    // google_links mapea googleUid -> clientId; googleAuthLogin confia en ese mapeo para emitir
    // una sesion real. Antes se podia escribir directo (solo se validaba la FORMA de clientId,
    // no que quien escribe sea su dueno) -- cualquiera con su propia cuenta de Google real podia
    // apuntar su propio googleUid al clientId de otra persona y tomar su cuenta por completo, sin
    // necesitar su PIN. Ahora solo las Cloud Functions (Admin SDK: googleLinkAccount,
    // unlinkGoogleAccount, linkPendingGoogleAfterOrder) leen/escriben esto.
    match /google_links/{googleUid} {
      allow read, write: if false;
    }

    match /admin_fcm_tokens/{doc} {
      allow read, write: if isAdmin();
    }

    match /phone_verifications/{doc} {
      allow read, write: if false;
    }

    // Conversaciones del agente de IA (chat web + WhatsApp) — el admin puede leerlas en vivo
    // desde Chat Roal (FODEXA), pero solo las Cloud Functions (Admin SDK) las escriben, para
    // que handleIncomingTurn/agentChatAdminReply sigan siendo la unica fuente de verdad.
    match /agent_conversations/{doc} {
      allow read: if isAdmin();
      allow write: if false;

      match /messages/{messageDoc} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }
    match /agent_rate_limits/{doc} {
      allow read, write: if false;
    }

    // Contadores diarios de uso/costo del agente (functions/agent/orchestrator.js,
    // logAgentUsage) -- el admin los lee desde el panel de Chat Roal, solo el Admin SDK escribe.
    match /agent_usage_daily/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Instrucciones operativas que el admin escribe desde Chat Roal (ej. "hoy recomienda X") —
    // el agente las lee con el Admin SDK (ignora estas reglas), esto solo protege la UI.
    match /agent_instructions/{doc} {
      allow read, write: if isAdmin();
    }

    // Mensajes preestablecidos de Chat Roal (bienvenida, pedido en camino, datos de pago, etc.)
    // -- solo el admin los crea/edita/borra desde el panel de configuración.
    match /agent_canned_messages/{doc} {
      allow read, write: if isAdmin();
    }

    // Memoria de tarifas de domicilio por dirección de texto — compartida entre el POS
    // (src/js/admin.js) y el agente de IA. No tenía regla propia (fallaba en silencio para
    // el POS, el agente igual funciona vía Admin SDK).
    match /domicilio_tarifas/{doc} {
      allow read, write: if isAdmin();
    }

    match /visitas/{doc} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /codigos_cupon/{code} {
      allow create: if true
        && request.resource.data.code is string
        && request.resource.data.code.size() == 6
        && request.resource.data.status == 'pending';
      allow read:   if true;
      allow delete: if true;
      allow update: if isAdmin();
    }

    match /meseros/{token} {
      allow get: if true;
      allow list: if isAdmin();
      allow update: if isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentSessionId']);
      allow create, delete: if isAdmin();
    }

    match /mesero_sesiones/{sessionId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if true
        && request.resource.data.meseroId is string
        && request.resource.data.meseroId.size() > 0
        && request.resource.data.abiertoAt != null
        && request.resource.data.cerradoAt == null;
      allow update: if request.resource.data.meseroId == resource.data.meseroId
        && request.resource.data.abiertoAt == resource.data.abiertoAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cerradoAt']);
    }

    match /resumen_ventas/{doc} {
      allow read, write: if isAdmin();
    }
    match /admin_estado/{doc} {
      allow read, write: if isAdmin();
    }
    match /cierres_caja/{doc} {
      allow read, write: if isAdmin();
    }
    match /pos_tickets/{doc} {
      allow read, write: if isAdmin();
    }
    match /gastos_caja/{doc} {
      allow read, write: if isAdmin();
    }
    // Auditoria de adminAdjustLoyaltyPoints (functions/index.js) -- solo lectura desde el admin
    // (para el historial de ajustes por cliente); la escritura es EXCLUSIVA del Admin SDK dentro
    // de esa Cloud Function, nunca desde el navegador (ni siquiera un admin autenticado).
    match /ajustes_puntos_lealtad/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /proveedores/{doc} {
      allow read, write: if isAdmin();
    }
    match /estadisticas/{doc} {
      allow read, write: if isAdmin();
    }

    match /admins/{uid} {
      allow read, write: if false;
    }
  }
}
